public/data/cctv-backend-demo/
site/data/cctv-backend-demo/
public/data/mnist-backend-demo/
site/data/mnist-backend-demo/
public/data/chess-backend-demo/
site/data/chess-backend-demo/
public/data/rubiks-backend-demo/
site/data/rubiks-backend-demo/

