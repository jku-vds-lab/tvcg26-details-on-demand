# Deployed-site build output (regenerated by `npm run build`, published by CI).
# Only site/index.html (hand-maintained shell) and the two integration-test
# fixtures under site/data/ are tracked.
site/*
!site/index.html
!site/data/
site/data/*
!site/data/combination_example_2.csv
!site/data/combination-example-2_knng_splines_stability.json.gz

# tsc -b emits compiled twins next to the sources on every `npm run build`
# (a .d.ts per module, plus .js/.d.ts per jest suite). Nothing reads them:
# vite bundles the .ts/.tsx sources and jest's testMatch is .ts/.tsx only,
# so they stay untracked. Hand-written ambient declarations are re-included.
src/**/*.js
src/**/*.d.ts
!src/vite-env.d.ts
!src/types/clipper-lib.d.ts
!src/types/catmull-rom-interpolator.d.ts
!src/workers/worker.d.ts
