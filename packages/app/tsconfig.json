{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "baseUrl": "./",
    "jsx": "react-jsx",
    "paths": {
      "@scaling": ["src/scaling.stub.ts"],
      "src/*": ["src/*"],
      "*": ["src/types/*"]
    },
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types", "./src/types"],
    "allowJs": true,
    "checkJs": false,
    "emitDeclarationOnly": false,
    "types": ["node", "react", "react-dom", "jest"]
  },
  "include": ["src", "src/types", "node_modules/@types"],
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
